# Public site address, no trailing slash (http://localhost:3000 when developing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Developers > API keys (use test keys until launch)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Created by `npm run stripe:setup`, or copy from the Stripe dashboard
STRIPE_PRICE_ID=price_...

# Free plan allowance per calendar month
FREE_SCANS_PER_MONTH=3
